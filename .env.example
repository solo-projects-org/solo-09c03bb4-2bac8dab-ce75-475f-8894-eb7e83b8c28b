# 复制为 .env 后可被 docker compose 自动读取；下列均为默认值
APP_AET=RETRIEVER
PACS_AET=MYPACS
STORE_PORT=11113
PACS_PORT=11112
# 模拟 PACS 每个实例发送间隔（秒），调大可更清楚观察交错回传
MOVE_DELAY=1.0
# 每 N 个实例重复投送一次（0 关闭）
MOVE_DUPLICATE_EVERY=3
# 四个虚构检查各自的 CT 实例数（第 4 个含批外引用，演示拒绝发布）
STUDY_COUNTS=8,6,5,2
# 去标识新 UID 的根（不同部署应不同；同批重试始终一致）
ANON_UID_ROOT=1.2.826.0.1.3680043.10.999
ANON_PATIENT_PREFIX=ANON
